# Provider secrets are server-only. Never prefix them with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://okvydjnyhtgrdhbdmvjy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required only on the server. Used by durable render workers and never sent to browsers.
SUPABASE_SECRET_KEY=
RUNWAYML_API_SECRET=

# Alibaba Direct, US (Virginia). Workspace and API key must be from the same region.
ALIBABA_API_KEY=
ALIBABA_WORKSPACE_ID=

# Optional but recommended for structured AI story planning.
# Create this in Vercel AI Gateway. If omitted, PixenarMV falls back to a deterministic planner.
AI_GATEWAY_API_KEY=
PIXENAR_STORY_MODEL=openai/gpt-5.4-mini

# Server-only dialogue voice generation.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
